{
  "name": "copilotkit-microsoft-agent-framework-starter",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "concurrently \"npm run dev:ui\" \"npm run dev:agent\" --names ui,agent --prefix-colors blue,green --kill-others",
    "dev:debug": "LOG_LEVEL=debug npm run dev",
    "dev:agent": "scripts\\run-agent.bat",
    "dev:ui": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "next lint",
    "install:agent": "scripts\\setup-agent.bat",
    "postinstall": "node -e \"if(process.env.VERCEL||process.env.CI||process.platform!=='win32'){process.exit(0)}require('child_process').execSync('npm run install:agent',{stdio:'inherit'})\""
  },
  "dependencies": {
    "@ag-ui/client": "0.0.57",
    "@copilotkit/react-core": "^1.64.1",
    "@copilotkit/react-ui": "^1.64.1",
    "@copilotkit/runtime": "^1.64.1",
    "lucide-react": "^1.22.0",
    "next": "^16.2.12",
    "react": "^19.2.1",
    "react-dom": "^19.2.1",
    "sarvamai": "^1.1.7",
    "zod": "^3.24.4"
  },
  "devDependencies": {
    "@playwright/test": "^1.60.0",
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "baseline-browser-mapping": "^2.11.8",
    "concurrently": "^9.1.2",
    "playwright": "^1.60.0",
    "tailwindcss": "^4",
    "typescript": "^5"
  }
}
